{
  "$schema": "https://dref.dev/schemas/v1/domain.json",
  "name": "order-api-contract",
  "version": "1.1.0",
  "description": "The public contract of the order API, exactly as a client sees it. No upstream providers: these models describe the wire format itself.",
  "defaults": {
    "formats": {
      "date": "YYYY-MM-DD",
      "time": "HH:mm:ss",
      "dateTime": "YYYY-MM-DDTHH:mm:ssZ"
    },
    "fields": {
      "CurrencyCode": {
        "type": "String",
        "rules": [{ "type": "uppercase" }, { "type": "enum", "param": ["USD", "EUR"] }]
      },
      "PositiveMoney": {
        "type": "Number",
        "rules": [{ "type": "positive" }, { "type": "precision", "param": 2 }]
      }
    }
  },
  "models": [
    {
      "name": "ProductResponse",
      "authority": "external",
      "properties": [
        { "name": "id", "type": "String", "required": true, "key": true },
        { "name": "name", "type": "String", "required": true, "rules": [{ "type": "notEmpty" }] },
        { "name": "unitPrice", "type": "PositiveMoney", "required": true },
        { "name": "currency", "type": "CurrencyCode", "required": true }
      ]
    },
    {
      "name": "OrderResponse",
      "authority": "external",
      "properties": [
        { "name": "id", "type": "String", "required": true, "key": true },
        { "name": "customerId", "type": "String", "required": true },
        { "name": "productId", "type": "String", "required": true },
        { "name": "productName", "type": "String", "required": true },
        {
          "name": "quantity",
          "type": "Number",
          "required": true,
          "rules": [{ "type": "positiveInteger" }]
        },
        { "name": "total", "type": "PositiveMoney", "required": true },
        { "name": "currency", "type": "CurrencyCode", "required": true },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "rules": [{ "type": "enum", "param": ["confirmed"] }]
        }
      ]
    },
    {
      "name": "ApiError",
      "authority": "external",
      "properties": [
        { "name": "code", "type": "String", "required": true, "key": true },
        { "name": "message", "type": "String", "required": false, "rules": [{ "type": "maxLength", "param": 500 }] }
      ]
    }
  ]
}
