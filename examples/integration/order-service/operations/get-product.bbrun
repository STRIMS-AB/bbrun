// Implements GET /products/{id}. request.path is supplied by the Java router.
catalogApi.get("/products/${request.path.id}")
if response.status == 404 {
    status(404)
    return { "code": "PRODUCT_NOT_FOUND" }
}
if response.status != 200 {
    status(502)
    return { "code": "CATALOG_UNAVAILABLE" }
}

// The provider speaks sku/label/price_cents. Map and validate inside the service.
Product product = response.body
return product
